@using ExamPortal.BusinessLogic.ViewModel.AdminDashboard
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}
@model AdminDashboardViewModel
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Total Users</div>
                        <h4 class="fw-bold"> @Model.TotalUsers</h4>
                    </div>
                    <i class="bi bi-people-fill fs-2 text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted">Total Exams</div>
                        <h4 class="fw-bold"> @Model.TotalExams</h4>
                    </div>
                    <i class="bi bi-journal-richtext fs-2 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Active Exams</div>
                        <h4 class="fw-bold"> @Model.ActiveExams</h4>
                    </div>
                    <i class="bi bi-play-circle-fill fs-2 text-info"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Total Attempts</div>
                        <h4 class="fw-bold"> @Model.TotalAttempts</h4>
                    </div>
                    <i class="bi bi-bar-chart-fill fs-2 text-warning"></i>
                </div>
            </div>
        </div>
    </div>


    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white fw-bold">Quick Actions</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <a href="/Examination/Index" class="card text-decoration-none h-100 action-card shadow-sm">
                                <div class="card-body text-center">
                                    <i class="bi bi-file-earmark-plus fs-2 text-primary mb-2"></i>
                                    <div class="fw-semibold text-dark">Create Exam</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/Student/Index" class="card text-decoration-none h-100 action-card shadow-sm">
                                <div class="card-body text-center">
                                    <i class="bi bi-people fs-2 text-success mb-2"></i>
                                    <div class="fw-semibold text-dark">Manage Users</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="Announcement/Index" class="card text-decoration-none h-100 action-card shadow-sm">
                                <div class="card-body text-center">
                                    <i class="bi bi-megaphone-fill fs-2 text-warning mb-2"></i>
                                    <div class="fw-semibold text-dark">Send Announcements</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border shadow-sm">
                <div class="card-header bg-white fw-bold">Recent Activities</div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong> @activity.Type:</strong> @activity.Message
                                    </div>
                                    <small class="text-muted">@activity.Time.ToString("dd MMM yyyy hh:mm tt")</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No recent activities.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Exams -->
        <div class="col-lg-4">
            <div class="card border shadow-sm">
                <div class="card-header bg-white fw-bold">Upcoming Exams</div>
                <div class="card-body">
                    @if (Model.UpcomingExams.Any())
                    {
                        <div class="list-group">
                            @foreach (var exam in Model.UpcomingExams)
                            {
                                <div class="list-group-item d-flex justify-content-between">
                                    <div>
                                        <div class="fw-semibold"> @exam.Title</div>
                                        <small class="text-muted">@exam.ExamDate.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-primary fw-bold">@exam.RegistrationCount</span><br />
                                        <small class="text-muted">registered</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No upcoming exams.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
