@using ExamPortal.BusinessLogic.ViewModel.Examintaion
@model List<QuestionListItemViewModel>
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 primary-color">Added Questions</h5>
    </div>
    <div class="card-body" style="max-height: 300px; overflow-y: auto;">
        @if (Model?.Any() ?? false)
        {
            <ul class="list-group questions-container ">
                @foreach (var q in Model)
                {
                    <li data-questionid="@q.Id" class=" list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong class="primary-color">@q.QuestionText</strong> <br />
                            <small class="primary-color">Type: @q.QuestionType | Marks: @q.Marks</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-2 edit-question"
                                data-questionid="@q.Id">Edit</button>
                            <button data-bs-toggle="modal" data-bs-target="#deleteQuestionModal" onclick="deleteQuestion(@q.Id)"
                                class="btn btn-sm btn-outline-danger delete-question" data-questionid="@q.Id">Delete</button>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No questions added yet.</p>
        }
    </div>
</div>


@* Delete question modal  *@
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-labelledby="deleteQuestionModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle delete-icon"></i>
                <p class="mb-0">Are you sure you want to delete this question?</p>
            </div>
            <hr>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn primary-button-v1" onclick="confirmQuestionDelete()">Yes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>