@using ExamPortal.BusinessLogic.ViewModel.Examintaion
@model List<QuestionListItemViewModel> 
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0" style="color: #0066a7;">Added Questions</h5>
    </div>
    <div class="card-body" style="max-height: 300px; overflow-y: auto;">
        @if (Model?.Any() ?? false)
        {
            <ul class="list-group">
                @foreach (var q in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@q.QuestionText</strong> <br />
                            <small>Type: @q.QuestionType | Marks: @q.Marks</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-2 edit-question" data-id="@q.Id">Edit</button>
                            <button class="btn btn-sm btn-outline-danger delete-question" data-id="@q.Id">Delete</button>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No questions added yet.</p>
        }
    </div>
</div>

