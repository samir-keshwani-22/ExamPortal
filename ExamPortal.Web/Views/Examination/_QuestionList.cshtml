@using ExamPortal.BusinessLogic.ViewModel.Examintaion
@model List<QuestionListItemViewModel>
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 primary-color">Added Questions</h5>
    </div>
    <div class="card-body" style="max-height: 300px; overflow-y: auto;">
        @if (Model?.Any() ?? false)
        {
            <ul class="list-group">
                @foreach (var q in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong class="primary-color">@q.QuestionText</strong> <br />
                            <small class="primary-color">Type: @q.QuestionType | Marks: @q.Marks</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-2 edit-question" data-id="@q.Id">Edit</button>
                            <button class="btn btn-sm btn-outline-danger delete-question" data-id="@q.Id">Delete</button>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No questions added yet.</p>
        }
    </div>
</div>

@section Scripts {
    <script>

    </script>
}
