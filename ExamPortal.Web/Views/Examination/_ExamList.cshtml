@using ExamPortal.BusinessLogic.ViewModel.Examintaion
@model List<ExamViewModel>

<table class="table table-hover mt-3">
    <thead>
        <tr>
            <th>Title <i role="button" class="sortable ps-1 bi bi-arrow-down-up" data-column="Title"></i></th>
            <th class="text-center">Duration (mins)</th>
            <th class="text-center">Total Marks</th>
            <th class="text-center">Start Date</th>
            <th class="text-center">End Date</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var exam in Model)
            {
                <tr>
                    <td>@exam.Title</td>
                    <td class="text-center">@exam.Duration</td>
                    <td class="text-center">@exam.TotalMarks</td>
                    <td class="text-center">@exam.StartDate.ToString("dd MMM yyyy")</td>
                    <td class="text-center">@exam.EndDate.ToString("dd MMM yyyy")</td>
                    <td class="text-center">

                        <i role="button" class="fa-solid fa-pen bg-black mx-2 edit-exam-icon primary-color"
                            data-exam-id="@exam.Id"></i>
                        <i role="button" class="fa-solid fa-trash primary-color" data-bs-toggle="modal"
                            data-bs-target="#deleteExamModal"></i>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No exams found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Delete Modal -->
<div class="modal fade" id="deleteExamModal" tabindex="-1" aria-labelledby="deleteExamModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle warning-icon"></i>
                <p class="mb-0">Are you sure you want to delete this exam?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger" onclick="confirmExamDelete()">Yes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>