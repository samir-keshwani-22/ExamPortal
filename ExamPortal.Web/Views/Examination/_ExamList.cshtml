@using ExamPortal.BusinessLogic.ViewModel.Examintaion
@model List<ExamViewModel>

<table class="table table-hover border mt-3">
    <thead>
        <tr class=" bg-primary text-white">
            <th>Title </th>
            <th class="text-center">Duration (mins)</th>
            <th class="text-center">Total Marks</th>
            <th class="text-center">Start Date</th>
            <th class="text-center">End Date</th>
            <th class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var exam in Model)
            {
                var totalMarks = @exam.TotalMarks == null ? 0 : @exam.TotalMarks;
                <tr>
                    <td>@exam.Title</td>
                    <td class="text-center">@exam.Duration</td>
                    <td class="text-center">@totalMarks </td>
                    <td class="text-center">@exam.StartDate.ToString("dd MMM yyyy")</td>
                    <td class="text-center">@exam.EndDate.ToString("dd MMM yyyy")</td>
                    <td class="text-center">
                        <i data-toggle="tooltip" data-placement="bottom" title="Edit the exam" role="button"
                            class="fa-solid fa-pen bg-black mx-2 edit-exam-icon primary-color" data-exam-id="@exam.Id"></i>
                        <i data-toggle="tooltip" data-placement="bottom" title="Delete the question" role="button"
                            class="fa-solid fa-trash mx-2 primary-color" data-bs-toggle="modal"
                            data-bs-target="#deleteExamModal" onclick="deleteExam(@exam.Id)"></i>
                        <i data-toggle="tooltip" data-placement="bottom" title="Edit the question" role="button"
                            onclick="location.href='@Url.Action("AddQuestions", "Examination", new { examId = @exam.Id })'"
                            class="bi bi-patch-question-fill mx-2 primary-color"></i>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No exams found.</td>
            </tr>
        }
    </tbody>
</table>
