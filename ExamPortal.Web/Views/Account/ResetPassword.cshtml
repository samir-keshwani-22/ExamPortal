@using ExamPortal.BusinessLogic.ViewModel.Account
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Page";
}

@model ResetPasswordViewModel


<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container    py-3 px-3 px-md-4">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0" style="border-radius: 1rem; overflow-x: hidden;  ">
                    <div class="card-body p-4 text-center">
                        <div class="    ">
                            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                                <input type="hidden" asp-for="Token" />
                                <div class="d-flex flex-column align-items-center mb-4">
                                    <img class="login-logo mb-2"
                                        src="@Url.Content("~/img/logos/examportal-logo-transparent.png")"
                                        alt="Exam Portal Logo" />
                                    <h2 class="fw-bold primary-color">Reset Password</h2>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12">
                                        <div class="form-floating  text-black mb-1">
                                            <input asp-for="Password" type="password" class="form-control"
                                                id="floatingPassword" placeholder="New Password">
                                            <label for="floatingPassword">New Password</label>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-floating  text-black mb-1">
                                            <input asp-for="ConfirmPassword" type="password" class="form-control"
                                                id="floatingPassword" placeholder="Password">
                                            <label for="floatingPassword">Confirm New Password</label>
                                        </div>
                                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>
                                <button class="w-100 mb-2 mt-3 btn border    primary-button-with-bg  btn-lg px-5 "
                                    type="submit">Change Password</button>
                                <a asp-controller="Account" asp-action="Login"
                                    class="w-100 mb-2 btn border    primary-button  btn-lg px-5 " type="submit">Back
                                    to
                                    Login</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>