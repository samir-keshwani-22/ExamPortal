@using ExamPortal.BusinessLogic.ViewModel.Account
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login Page";
}

@model LoginViewModel
<div class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="container    py-3 px-3 px-md-4">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0" style="border-radius: 1rem; overflow-x: hidden;  ">
                    <div class="card-body p-4 text-center">
                        <div class="    ">
                            <form asp-action="Login" asp-controller="Account" method="post">
                                <div class="d-flex flex-column align-items-center mb-4">
                                    <img class="login-logo mb-2"
                                        src="@Url.Content("~/img/logos/examportal-logo-transparent.png")"
                                        alt="Exam Portal Logo" />
                                    <h2 class="fw-bold primary-color">LOGIN</h2>
                                </div>


                                <div class="row g-2">
                                    <div class="col-12">
                                        <div class="form-floating text-black mb-3  ">
                                            <input asp-for="Email" type="email" class="form-control" id="floatingInput"
                                                placeholder="name@example.com">
                                            <label class="text-black" for="floatingInput">Email address</label>
                                            <span style="" class="text-danger  mt-2 mb-3"></span>
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <div class=" form-floating  text-black mb-3">
                                            <input asp-for="Password" type="password" class="form-control"
                                                id="floatingPassword" placeholder="Password">
                                            <label for="floatingPassword">Password</label>
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <div class=" form-check mb-3 d-flex justify-content-start">
                                            <input class="form-check-input shadow-none  me-3" type="checkbox"
                                                id="flexCheckDefault" asp-for="RememberMe">
                                            <label class="form-check-label remember-msg" for="flexCheckDefault">
                                                Remember me
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <button class="w-100 btn border    primary-button  btn-lg px-5 " type="submit">Sign
                                    In</button>
                            </form>
                            <div class="row">
                                <div class="col-12">
                                    <hr class="mt-5 mb-4 border-secondary-subtle">
                                    <div class="d-flex gap-2 gap-md-4 flex-column flex-md-row justify-content-md-end">
                                        <a asp-action="Register" asp-controller="Account"
                                            class="link-secondary text-decoration-none">Create new account</a>
                                        <a href="#!" class="link-secondary text-decoration-none">Forgot password</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>