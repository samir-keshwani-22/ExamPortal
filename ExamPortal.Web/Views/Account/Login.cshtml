@using ExamPortal.BusinessLogic.ViewModel.Account
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login Page";
}

@model LoginViewModel
<div class="vh-100">
    <div class="container py-5   h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-lg-7">
                <div class="card   " style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">
                        <div class="mb-5 mt-5 pb-5">
                            <form method="post">
                                <h2 class="fw-bold mb-4 primary-color  ">LOGIN</h2>

                                <div>

                                    <div class="form-floating text-black mb-3  ">
                                        <input asp-for="Email" type="email" class="form-control" id="floatingInput"
                                            placeholder="name@example.com">
                                        <label class="text-black" for="floatingInput">Email address</label>
                                        <span style="" class="text-danger  mt-2 mb-3"></span>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="form-floating  text-black mb-3">
                                    <input type="password" class="form-control" id="floatingPassword"
                                        placeholder="Password">
                                    <label for="floatingPassword">Password</label>
                                    <span class="text-danger"></span>
                                </div>
                                <button class="w-100 btn border    primary-button  btn-lg px-5 " type="submit">Sign
                                    In</button>
                            </form>
                            <div class="row">
                                <div class="col-12">
                                    <hr class="mt-5 mb-4 border-secondary-subtle">
                                    <div class="d-flex gap-2 gap-md-4 flex-column flex-md-row justify-content-md-end">
                                        <a asp-action="Register" asp-controller="Account"
                                            class="link-secondary text-decoration-none">Create new account</a>
                                        <a href="#!" class="link-secondary text-decoration-none">Forgot password</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>