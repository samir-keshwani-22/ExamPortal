<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExamPortal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/delete-modal.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body style="height: 100vh; overflow: hidden;">
    <div class="d-flex flex-column h-100">
        <div class="flex-grow-1 d-flex">
            <!-- Sidebar -->
            <div class="sidebar-container    p-0" id="sidebarContainer">
                <aside id="sidebar" class="vh-100">
                    <div class="h-100">
                        <div class="sidebar-logo">
                            <img src="@Url.Content("~/img/logos/examportal-logo-transparent.png")" class="img-fluid"
                                alt="EXAM_PORTAL Logo">
                        </div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-item">
                                <a href="@Url.Action("Index", "Home")"
                                    class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")">
                                    <i class="fas fa-tachometer-alt pe-2"></i>Dashboard
                                </a>
                            </li>
                            <li class="sidebar-item">
                                <a asp-action="UserList" asp-controller="User"
                                    class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "")">
                                    <i class="fas fa-user pe-2"></i>Users
                                </a>
                            </li>
                        </ul>
                    </div>
                </aside>
            </div>

            <!-- Main content -->
            <div class="col content-container p-0 d-flex flex-column" style="overflow: hidden;">
                <nav class="header">
                    <button class="btn btn-light" id="toggleSidebar"><i class="fas fa-bars"></i></button>
                    <div class="dropdown d-flex">


                        <a class="btn py-0" href="#" data-bs-toggle="dropdown" style="background-color: #333446;"
                            aria-expanded="false">
                            <img id="userProfileImage" src="~/img/default_profile_picture.png"
                                class="img-fluid rounded-circle"
                                style="min-width:49px; max-width:49px; min-height:49px; max-height:49px;" />
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="#">
                                    <img style="width: 28%;" id="dropdownUserProfileImage"
                                        src="~/img/default_profile_picture.png" class="img-fluid rounded-circle" />
                                    <span id="username"
                                        class="ms-1 fs-6 fw-bold text-secondary d-inline-block text-wrap"
                                        style="max-width:135px;">Username</span>
                                </a>
                            </li>
                            <hr class="my-1" />
                            <li>
                                <a asp-action="MyProfile" asp-controller="Profile"
                                    class="dropdown-item d-flex align-items-center text-secondary">
                                    <i class="fa-solid fa-circle-user me-2"></i><span class="fw-semibold">My
                                        Profile</span>
                                </a>
                            </li>
                            <li>
                                <a asp-action="ChangePassword" asp-controller="Profile"
                                    class="dropdown-item d-flex align-items-center text-secondary">
                                    <i class="fa-solid fa-rotate-left me-2"></i><span class="fw-semibold">Change
                                        Password</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center text-secondary" data-bs-toggle="modal"
                                    data-bs-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt me-2"></i><span class="fw-semibold">Logout</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>

                <div class="flex-grow-1 overflow-auto" style="background-color: #f2f2f2;">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <!-- Offcanvas Sidebar for Mobile -->

    <div class="offcanvas offcanvas-start" id="mobileSidebar">
        <div class="offcanvas-header  ">
            <div class="sidebar-logo">
                <img src="@Url.Content("~/img/logos/examportal-logo-transparent.png")" class="img-fluid"
                    alt="Exam Portal Logo">
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="sidebar-nav ">
                <li class="sidebar-item  ">
                    <a href="@Url.Action("Index", "Home")"
                        class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")"><i
                            class="fas fa-tachometer-alt pe-2"></i>Dashboard</a>
                </li>

                <li class="sidebar-item"><a asp-action="UserList" asp-controller="User"
                        class="sidebar-link  @(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "") "><i
                            class="fas fa-user pe-2"></i>Users</a></li>


            </ul>
        </div>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="fas fa-exclamation-triangle warning-icon"></i>
                    <p class="mb-0">Are you sure you want to logout?</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <form method="post" asp-action="Logout" asp-controller="Account">
                        <button type="submit" class="btn btn-danger">Yes</button>
                    </form>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "4000"
        };

        $(document).ready(function () {
            const success = '@TempData["SuccessMessage"]';
            const error = '@TempData["ErrorMessage"]';
            const warning = '@TempData["WarningMessage"]';
            const info = '@TempData["InfoMessage"]';

            if (success) toastr.success(success);
            if (error) toastr.error(error);
            if (warning) toastr.warning(warning);
            if (info) toastr.info(info);

            @* $.ajax({
                url: "/User/GetUsernameAndImage",
                type: "GET",
                success: function (response) {
                    if (response.success) {
                        $("#userProfileImage").attr("src", response.profileImg);
                        $("#dropdownUserProfileImage").attr("src", response.profileImg);
                        $("#username").text(response.username);
                    }
                },
                error: function () {
                    console.log("Failed to load user profile.");
                }
            }); *@
        });

        document.getElementById("toggleSidebar").addEventListener("click", function () {
            if (window.innerWidth <= 768) {
                new bootstrap.Offcanvas(document.getElementById('mobileSidebar')).show();
            } else {
                document.getElementById("sidebarContainer").classList.toggle("collapsed");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
