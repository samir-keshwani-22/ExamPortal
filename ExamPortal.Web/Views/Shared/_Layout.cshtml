@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExamPortal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/delete-modal.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body style="height: 100vh; overflow: hidden;">
    <div class="d-flex flex-column h-100">
        <div class="flex-grow-1 d-flex">
            <!-- Sidebar -->
            <div class="sidebar-container border-end p-0" id="sidebarContainer">
                <aside id="sidebar" class="vh-100">
                    <div class="h-100">
                        <div class="sidebar-logo">
                            <img src="@Url.Content("~/img/logos/examportal-logo-transparent.png")" class="img-fluid"
                                alt="EXAM_PORTAL Logo">
                        </div>
                        <ul class="sidebar-nav">
                            <li class="sidebar-item">
                                <a href="@Url.Action("Index", "Home")"
                                    class="sidebar-link @((ViewContext.RouteData.Values["controller"].ToString() == "AdminDashboard") || (ViewContext.RouteData.Values["controller"].ToString() == "StudentDashboard") ? "active" : "")">
                                    <i class="fas fa-tachometer-alt pe-2"></i>Dashboard
                                </a>
                            </li>
                            @if (User.FindFirstValue(ClaimTypes.Role) == "student")
                            {
                                <li class="sidebar-item">
                                    <a asp-action="Index" asp-controller="Exams"
                                        class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Exams" ? "active" : "")">
                                        <i class="bi bi-clipboard2-check-fill pe-2"></i>
                                        Exams
                                    </a>
                                </li>
                            }
                            @if (User.FindFirstValue(ClaimTypes.Role) == "admin")
                            {
                                <li class="sidebar-item">
                                    <a asp-action="Index" asp-controller="Examination"
                                        class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Examination" ? "active" : "")">
                                        <i class="bi bi-journal-album pe-2"></i>Examination
                                    </a>
                                </li>
                            }

                            @if (User.FindFirstValue(ClaimTypes.Role) == "admin")
                            {
                                <li class="sidebar-item">
                                    <a asp-action="Index" asp-controller="Student"
                                        class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Student" ? "active" : "")">
                                        <i class="fas fa-user pe-2"></i>Student
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </aside>
            </div>

            <!-- Main content -->
            <div class="col content-container p-0 d-flex flex-column" style="overflow: hidden;">
                <nav class="header">
                    <button class="btn btn-light" id="toggleSidebar"><i class="fas fa-bars"></i></button>
                    <div class="dropdown d-flex">
                        <div class="dropdown me-2" id="notificationDropdown">
                            <button
                                class="btn position-relative bg-white border rounded-circle shadow-sm px-3 py-2 me-2"
                                data-bs-toggle="dropdown" aria-expanded="false" id="notificationBell"
                                title="View Announcements & Notifications">
                                <i class="bi bi-bell fs-5 text-dark"></i>
                                <span id="announcementDot"
                                    style="transform:translate(-93%, -4%) !important; padding: 0.35rem !important;"
                                    class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-white rounded-circle d-none">
                                    <span class="visually-hidden">New announcements</span>
                                </span>
                                <span id="notificationDot"
                                    style="transform:translate(-93%, 16%) !important; padding: 0.35rem !important;"
                                    class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-white rounded-circle d-none">
                                    <span class="visually-hidden">New notifications</span>
                                </span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end p-2 shadow-sm" style="min-width:350px;"
                                id="notificationDropdownMenu">
                                <li>
                                    <ul class="nav nav-tabs mb-2" id="notifTab" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link active" id="ann-tab" data-bs-toggle="tab"
                                                data-bs-target="#announcements" type="button"
                                                role="tab">Announcements</button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link" id="notif-tab" data-bs-toggle="tab"
                                                data-bs-target="#notifications" type="button"
                                                role="tab">Notifications</button>
                                        </li>
                                    </ul>
                                </li>
                                <li>
                                    <div class="tab-content mt-2">
                                        <div class="tab-pane fade show active" id="announcements" role="tabpanel">
                                            <ul id="announcementList" class="list-group p-0"></ul>
                                        </div>
                                        <div class="tab-pane fade" id="notifications" role="tabpanel">
                                            <ul id="notificationList" class="list-group p-0"></ul>
                                        </div>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <a class="btn py-0 " href="#" data-bs-toggle="dropdown"
                            style="background-color: var(--primary_color) ;" aria-expanded="false">
                            <img id="userProfileImage" src="~/img/default_profile_picture.png"
                                class="img-fluid rounded-circle"
                                style="min-width:49px; max-width:49px; min-height:49px; max-height:49px;" />
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="#">
                                    <img style="width: 28%;" id="dropdownUserProfileImage"
                                        src="~/img/default_profile_picture.png" class="img-fluid rounded-circle" />
                                    <span id="username"
                                        class="ms-1 fs-6 fw-bold text-secondary d-inline-block text-wrap"
                                        style="max-width:135px;">Username</span>
                                </a>
                            </li>
                            <hr class="my-1" />
                            <li>
                                <a asp-action="Index" asp-controller="Profile"
                                    class="dropdown-item d-flex align-items-center text-secondary">
                                    <i class="fa-solid fa-circle-user me-2"></i><span class="fw-semibold">My
                                        Profile</span>
                                </a>
                            </li>
                            <li>
                                <a onclick="getChangePasswordModal()"
                                    class="dropdown-item d-flex align-items-center text-secondary">
                                    <i class="bi bi-key-fill  me-2"></i><span class="fw-semibold">Change
                                        Password</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center text-secondary" data-bs-toggle="modal"
                                    data-bs-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt me-2"></i><span class="fw-semibold">Logout</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>

                <div class="flex-grow-1 overflow-auto" style="background-color: #f2f2f2;">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div id="changePasswordContainer"></div>

    <!-- Offcanvas Sidebar for Mobile -->
    <div class="offcanvas offcanvas-start" id="mobileSidebar">
        <div class="offcanvas-header">
            <div class="sidebar-logo">
                <img src="@Url.Content("~/img/logos/examportal-logo-transparent.png")" class="img-fluid"
                    alt="Exam Portal Logo">
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="sidebar-nav">
                <li class="sidebar-item">
                    <a href="@Url.Action("Index", "Home")"
                        class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")"><i
                            class="fas fa-tachometer-alt pe-2"></i>Dashboard</a>
                </li>
                @if (User.FindFirstValue(ClaimTypes.Role) == "student")
                {
                    <li class="sidebar-item">
                        <a asp-action="Index" asp-controller="Exams"
                            class="sidebar-link @(ViewContext.RouteData.Values["controller"].ToString() == "Exams" ? "active" : "")">
                            <i class="bi bi-clipboard2-check-fill pe-2"></i>
                            Exams
                        </a>
                    </li>
                }
                @if (User.FindFirstValue(ClaimTypes.Role) == "admin")
                {
                    <li class="sidebar-item"><a asp-action="Index" asp-controller="Examination"
                            class="sidebar-link  @(ViewContext.RouteData.Values["controller"].ToString() == "Examination" ? "active" : "") ">
                            <i class="bi bi-journal-album pe-2"></i>Examination</a></li>
                }
                @if (User.FindFirstValue(ClaimTypes.Role) == "admin")
                {
                    <li class="sidebar-item"><a asp-action="Index" asp-controller="Student"
                            class="sidebar-link  @(ViewContext.RouteData.Values["controller"].ToString() == "Student" ? "active" : "") "><i
                                class="fas fa-user pe-2"></i>Student</a></li>
                }
            </ul>
        </div>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="fas fa-exclamation-triangle warning-icon"></i>
                    <p class="mb-0">Are you sure you want to logout?</p>
                </div>
                <hr>
                <div class="modal-footer justify-content-center">
                    <form method="post" asp-action="Logout" asp-controller="Account">
                        <button type="submit" class="btn primary-button-v1">Yes</button>
                    </form>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "4000"
        };

        $(document).ready(function () {
            const success = '@TempData["SuccessMessage"]';
            const error = '@TempData["ErrorMessage"]';
            const warning = '@TempData["WarningMessage"]';
            const info = '@TempData["InfoMessage"]';

            if (success) toastr.success(success);
            if (error) toastr.error(error);
            if (warning) toastr.warning(warning);
            if (info) toastr.info(info);

            $.ajax({
                url: "/Profile/GetNameAndImage",
                type: "GET",
                success: function (response) {
                    if (response.success) {
                        $("#userProfileImage").attr("src", response.profileImg);
                        $("#dropdownUserProfileImage").attr("src", response.profileImg);
                        $("#username").text(response.username);
                    }
                },
                error: function () {
                    console.log("Failed to load user profile.");
                }
            });
        });

        document.getElementById("toggleSidebar").addEventListener("click", function () {
            if (window.innerWidth <= 768) {
                new bootstrap.Offcanvas(document.getElementById('mobileSidebar')).show();
            } else {
                document.getElementById("sidebarContainer").classList.toggle("collapsed");
            }
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>
    <script>

        const announcementConnection = new signalR.HubConnectionBuilder()
            .withUrl("/announcementHub")
            .build();

        announcementConnection.start().then(() => console.log("AnnouncementHub connected")).catch(err => console.error(err));
        announcementConnection.on("ReceiveAnnouncement", function (title, message) {
            checkUnreadAnnouncements();
            loadAnnouncements();
        });


        const notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        notificationConnection.start().then(() => console.log("NotificationHub connected")).catch(err => console.error(err));
        notificationConnection.on("ReceiveNotification", function (message) {
            checkUnreadNotifications();
            loadNotifications();
            toastr.info(message, "Exam Reminder");
        });


        function loadAnnouncements() {
            $.ajax({
                url: '/Announcement/GetRecent',
                method: 'GET',
                success: function (data) {
                    const $list = $("#announcementList");
                    $list.empty();

                    if (data && data.length > 0) {
                        data.forEach(item => {
                            $list.append(`
                                <li class="list-group-item px-2 py-1">
                                    <div class="fw-semibold">${item.title}</div>
                                    <div class="text-muted small">${item.message}</div>
                                </li>
                            `);
                        });
                    } else {
                        $list.append(`<li class="list-group-item text-muted px-2">No announcements found.</li>`);
                    }
                },
                error: function () {
                    $("#announcementList").html('<li class="list-group-item text-danger px-2">Error loading announcements</li>');
                }
            });
        }
        
        function loadNotifications() {
            $.ajax({
                url: '/Notification/GetRecent',
                method: 'GET',
                success: function (data) {
                    const $list = $("#notificationList");
                    $list.empty();

                    if (data && data.length > 0) {
                        data.forEach(item => {
                            $list.append(`
                                <li class="list-group-item px-2 py-1">
                                    <div class="fw-semibold">${item.title}</div>
                                    <div class="text-muted small">${item.message}</div>
                                    <div class="text-muted small">${item.createdAt}</div>
                                </li>
                            `);
                        });
                    } else {
                        $list.append(`<li class="list-group-item text-muted px-2">No notifications found.</li>`);
                    }
                },
                error: function () {
                    $("#notificationList").html('<li class="list-group-item text-danger px-2">Error loading notifications</li>');
                }
            });
        }


        function checkUnreadAnnouncements() {
            $.ajax({
                url: "/Announcement/HasUnread",
                method: "GET",
                success: function (response) {
                    if (response.hasUnread) {
                        $("#announcementDot").removeClass("d-none");
                    } else {
                        $("#announcementDot").addClass("d-none");
                    }
                }
            });
        }

        function checkUnreadNotifications() {
            $.ajax({
                url: "/Notification/HasUnread",
                method: "GET",
                success: function (response) {
                    if (response.hasUnread) {
                        $("#notificationDot").removeClass("d-none");
                    } else {
                        $("#notificationDot").addClass("d-none");
                    }
                }
            });
        }

        $("#ann-tab").on("click", function () {
            $.ajax({ url: "/Announcement/MarkAsRead", type: "POST" });
            $("#announcementDot").addClass("d-none");
            loadAnnouncements();
        });

        $("#notif-tab").on("click", function () {
            $.ajax({ url: "/Notification/MarkAllAsRead", type: "POST" });
            $("#notificationDot").addClass("d-none");
            loadNotifications();
        });
        $(document).ready(function () {
            $('#notificationDropdownMenu .nav-link').on('click', function (e) {
                e.stopPropagation();
            });
        });

        $(document).ready(function () {
            checkUnreadAnnouncements();
            checkUnreadNotifications();
            loadAnnouncements();
            loadNotifications();
        });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>