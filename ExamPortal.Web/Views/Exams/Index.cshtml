@{
    ViewData["Title"] = "Exams";
}
@using ExamPortal.BusinessLogic.ViewModel.Examintaion
@model List<ExamViewModel>  
  
<script src="~/js/exams.js"></script>
<div class="main">
    <div class="container-fluid mt-1 px-0 pt-2">
        <div class="container-fluid px-0" style="background-color: #f2f2f2;">
            <div class="heading-content py-2 mx-4 d-flex flex-column flex-md-row justify-content-between">
                <div class="heading-left fw-bolder">
                    <h1 style="color:  var(--primary_color);">Available Exams</h1>
                    <p class="lead   text-muted  ">Choose an exam to begin your assessment</p>
                </div>
            </div>
            <div class="content mx-4">
                <div class="row">
                    @foreach (var exam in Model)
                    {
                        <div class="col-lg-4 mb-4">
                            <div class="card h-100 border shadow-sm">
                                <div class="card-body ">
                                    <div class="d-flex justify-content-between align-items-start mb-3" style="height: 100px;">
                                        <div>
                                            <h4 class="fw-bold primary-color"> @exam.Title</h4>
                                            <p class="text-muted small "> @exam.Description</p>
                                        </div>
                                        <span
                                            class="badge p-2
                                                @(exam.ExamStatus == "Active" ? "bg-success" : exam.ExamStatus == "Upcoming" ? "bg-primary" : "bg-secondary")">
                                            @(exam.ExamStatus == "Active" ? "Available Now" : exam.ExamStatus == "Upcoming" ?
                                                                                    "Upcoming" : "Completed")
                                    </span>
                                </div>
                                <div class="row mb-3 primary-color">
                                    <div class="col-6 small  "><i class="bi bi-clock pe-2"></i> @exam.Duration min</div>
                                    <div class="col-6 small"><i class="bi bi-list-ol pe-2"></i> @exam.TotalQuestion
                                        questions</div>
                                    <div class="col-6 small "><i class="bi bi-award pe-2"></i>@exam.TotalMarks marks
                                    </div>
                                    <div class="col-6 small "><i
                                            class="bi bi-calendar pe-2"></i>@exam.StartDate.ToString("dd MMM yyyy")
                                    </div>
                                </div>
                                <div class="text-end">
                                    @* <button data-bs-toggle="modal"
                                    data-bs-target="#startExamModal" onclick="setExamStartId(@exam.Id)"    class="btn primary-button  "  @(exam.ExamStatus == "Completed"  ? "disabled" : "") >
                                        <i class="bi bi-play-fill"></i>@(exam.ExamStatus == "Active"  ? "Start Exam": exam.ExamStatus == "Completed"?"Finished":  "Register")  
                                    </button>  *@

                                    <button 
                                        data-bs-toggle="modal"
                                        data-bs-target="@(exam.ExamStatus == "Active" ? "#startExamModal" : "#registerExamModal")" 
                                        onclick="@(exam.ExamStatus == "Active" ? $"setExamStartId({exam.Id})" : $"setExamRegisterId({exam.Id})")"    
                                        class="btn primary-button"  
                                        @(exam.ExamStatus == "Completed" || exam.TotalQuestion==0 ? "disabled" : "")>
                                        <i class="bi bi-play-fill"></i>
                                        @(exam.ExamStatus == "Active" ? "Start Exam" : 
                                        exam.ExamStatus == "Completed" ? "Finished" : "Register")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                    @if (!Model.Any())
                    {
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-file-earmark-text fs-1 text-secondary mb-3"></i>
                            <h4>No Exams Available</h4>
                            <div class="text-muted">Check back later for new examinations.</div>
                        </div>
                    }
                </div>
            </div>
        </div> 
    </div>
</div> 

 <div class="modal fade" id="startExamModal" tabindex="-1" aria-labelledby="startExamLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center "> 
                         <i class="fa-regular fa-circle-check success-icon"></i>
                    <p class="mb-0">Are you sure you want to start the exam?</p>
                     
                </div>
                <hr>
                <div class="modal-footer justify-content-center">
                   
                        <button type="button" onclick="confirmExamStart()" class="btn primary-button-v1">Yes</button>
                  
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </div>
            </div>
        </div>
 </div>

 
<div class="modal fade" id="registerExamModal" tabindex="-1" aria-labelledby="registerExamLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center"> 
                <i class="fa-regular fa-calendar-check success-icon"></i>
                <p class="mb-0">Do you want to register for this exam?</p>
            </div>
            <hr>
            <div class="modal-footer justify-content-center">
                <button type="button" onclick="confirmExamRegistration()" class="btn primary-button-v1">Register</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>