@model ExamPortal.BusinessLogic.ViewModel.Exams.QuestionCardViewModel

<div class="bg-white rounded-4 shadow-sm border p-4">
    <div class="d-flex justify-content-between pb-3">
        <h5 class="mb-0">
            Question @Model.QuestionNumber of @Model.TotalQuestion
        </h5>
        <div class="text-muted small">Marks: @Model.Marks</div>
    </div>
    <h2 class="h6 fw-bold mb-4">@Model.QuestionText</h2>

    @if (Model.QuestionType == "MCQ" || Model.QuestionType == "TrueFalse")
    {
        for (int i = 0; i < Model.Options.Count; i++)
        {
            var option = Model.Options[i];
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="answer" id="@option.Id" value="@option.Id"
                    @(Model.SelectedOptionId == option.Id ? "checked" : "") />
                <label class="form-check-label" for="@option.Id">
                    @(option.OptionText)
                </label>
            </div>
        }
    }
    else
    {
        <span class="text-muted">Question type not supported yet.</span>
    }
</div>