@using ExamPortal.BusinessLogic.ViewModel.Exams
@{
    Layout = "_Layout";
    ViewData["Title"] = "Exam Page";
}
@model ExamInterfaceViewModel

<div class="container-fluid h-100 bg-light d-flex p-0">
    <div class="col-md-3 bg-white border-end d-flex flex-column p-0">
        <div class="p-4 border-bottom">
            <h2 class="h5 fw-bold mb-2">@Model.Title</h2>
            <div class="text-muted small mb-1">Duration: @Model.TotalDuration min</div>
            <div class="text-muted small mb-1">Total Questions: @Model.TotalQuestion</div>
            <div class="text-muted small">Total Marks: @Model.TotalMarks</div>
        </div>
        <div class="p-4 border-bottom">
            @await Html.PartialAsync("_Timer")
        </div>
        <div class="p-4 border-top">
            <button type="button" class="btn primary-button w-100" data-bs-toggle="modal" data-bs-target="#submitModal">
                <i class="bi bi-flag"></i> Submit Exam
            </button>
        </div>
    </div>
    <div class="col-md-9 d-flex flex-column p-0">
        <div class="bg-white border-bottom p-4">
            <div class="d-flex justify-content-end align-items-center">
                <div>
                    <button id="prevBtn" class="btn primary-button me-2"
                        onclick="navigateToQuestion(currentQuestionIndex - 1)">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>
                    <button id="nextBtn" class="btn primary-button"
                        onclick="navigateToQuestion(currentQuestionIndex + 1)">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="p-5 flex-grow-1">
            <div id="questionCardContainer">
                @await Html.PartialAsync("_QuestionCard", Model.FirstQuestion)
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="submitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title text-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i> Submit Exam
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to submit? You have answered 2 out of @Model.TotalQuestion questions.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn primary-button-v1" onclick="submitExam()">Submit</button>
                <button type="button" class="btn secondary-button" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var examId = @Model.ExamId;
        var currentQuestionIndex = 0;
        var totalQuestions = @Model.TotalQuestion;

        function navigateToQuestion(index) {
            if (index < 0 || index >= totalQuestions) return;

            $.ajax({
                url: '@Url.Action("GetQuestionCard", "Exams")',
                type: 'GET',
                data: { examId: examId, questionIndex: index },
                success: function (html) {
                    $("#questionCardContainer").html(html);
                    currentQuestionIndex = index;
                    updateNavButtons();
                }
            });
        }

        function updateNavButtons() {
            $("#prevBtn").prop("disabled", currentQuestionIndex === 0);
            $("#nextBtn").prop("disabled", currentQuestionIndex === totalQuestions - 1);
        }

        $(document).ready(function () {
            updateNavButtons();
        });
    </script>
}