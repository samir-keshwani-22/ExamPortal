@using ExamPortal.BusinessLogic.ViewModel.Student
@{
    ViewData["Title"] = "Student List";
}
<script src="~/js/student.js"></script>
@model List<StudentViewModel>
<div class="main">
    <div class="container-fluid mt-1 px-0 pt-2">
        <div class="container-fluid px-0" style="background-color: #f2f2f2;">
            <div class="heading-content py-2 mx-4 d-flex flex-column flex-md-row justify-content-between">
                <div class="heading-left fw-bolder">
                    <h1 style="color: #333446;">Students</h1>
                </div>
                <div class="heading-right justify-content-end d-flex align-items-center">
                    <a class="btn-anchor h-100" onclick="openAddStudentModal()">
                        <button type="button" class="btn border-2"
                            style="height: 100%; white-space: nowrap; color: white; background-color: var(--primary_color);">
                            <i class="fa-solid fa-plus"></i>
                            <span class="lh-sm">Add Student</span>
                        </button>
                    </a>
                </div>
            </div>
            <div class="content mx-4">
                <div class="table-responsive " id="studentListContainer">
                    @await Html.PartialAsync("_StudentList", Model)
                </div>
            </div>
        </div>
    </div>
</div>


<div id="addStudentContainer">
</div>
<div id="editStudentContainer">
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1" aria-labelledby="deleteStudentModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle delete-icon"></i>
                <p class="mb-0">Are you sure you want to delete this student?</p>
            </div>
            <hr>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn primary-button-v1" onclick="confirmStudentDelete()">Yes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>