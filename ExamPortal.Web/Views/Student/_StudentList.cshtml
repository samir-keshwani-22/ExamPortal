@using ExamPortal.BusinessLogic.ViewModel.Student
@model List<StudentViewModel>
<table class="table table-hover border  mt-3">
    <thead>
        <tr class=" bg-primary text-white">
            <th class="col-1  text-nowrap">Profile Photo</th>
            <th class="text-center  text-nowrap">First Name </th>
            <th class="text-center  text-nowrap">Last Name </th>
            <th class="text-center  text-nowrap">Email</th>
            <th class="text-center  text-nowrap">Phone Number</th>
            <th class="text-center  text-nowrap">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var student in Model)
            {
                <tr>
                    <td class="col-1"> <img class="img-fluid rounded-circle me-2" style="width: 3rem; height: 3rem;"
                            src="@student.ProfileImage" alt=""> </td>
                    <td class="text-center   text-nowrap">@student.FirstName</td>
                    <td class="text-center   text-nowrap">@student.LastName </td>
                    <td class="text-center   text-nowrap">@student.Email</td>
                    <td class="text-center   text-nowrap">@(@student.Phonenumber == null ? "N/A" : @student.Phonenumber)</td>
                    <td class="text-center   text-nowrap">
                        <i data-toggle="tooltip" data-student-id="@student.Id" data-placement="bottom" title="Edit student"
                            role="button" class="fa-solid fa-pen bg-black mx-2 edit-student-icon primary-color"
                            data-exam-id="@student.Id"></i>
                        <i onclick="deleteStudent(@student.Id)" data-toggle="tooltip" data-placement="bottom"
                            title="Delete student" role="button" class="fa-solid fa-trash mx-2 primary-color"
                            data-bs-toggle="modal" data-bs-target="#deleteStudentModal"></i>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No students found.</td>
            </tr>
        }
    </tbody>
</table>
