@model ExamPortal.BusinessLogic.ViewModel.StudentDashboard.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_Layout";
    string GetScoreColor(double score, double maxScore)
    {
        var percentage = (score / maxScore) * 100;
        if (percentage >= 80) return "text-success";
        if (percentage >= 60) return "text-warning";
        return "text-danger";
    }
    string GetStatusIcon(string status)
    {
        return status switch
        {
            "completed" => "bi-check-circle-fill text-success",
            "missed" => "bi-x-circle-fill text-danger",
            _ => "bi-clock text-secondary"
        };
    }
}

<div class="container-fluid py-4">
    <div class="bg-primary text-white p-4 rounded mb-4">
        <h2 class="mb-1">Welcome back, @Model.StudentName</h2>
        <p>You have @Model.UpcomingExamCount upcoming exams. Keep up the great work!</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Total Exams</div>
                        <h4 class="fw-bold">@Model.TotalExams</h4>
                    </div>
                    <i class="bi bi-file-earmark-text-fill fs-2 text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Completed Exams</div>
                        <h4 class="fw-bold">@Model.CompletedExams</h4>
                    </div>
                    <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Average Score</div>
                        <h4 class="fw-bold">@Model.AverageScore%</h4>
                    </div>
                    <i class="bi bi-graph-up fs-2 text-warning"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted mb-2">Quick Links</div>
                    <div class="d-flex flex-row gap-3 flex-wrap">
                        <a href="/Profile" class="text-decoration-none text-primary"><i
                                class="bi bi-person me-1"></i>Profile</a>
                        <a href="/Feedback" class="text-decoration-none"><i
                                class="bi bi-chat-left-text me-1"></i>Feedback</a>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white fw-bold">Upcoming Exams</div>
                <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                    @if (Model.UpcomingExams.Any())
                    {
                        @foreach (var exam in Model.UpcomingExams)
                        {
                            <div class="d-flex justify-content-between border-bottom py-3">
                                <div>
                                    <h6 class="mb-1"> @exam.Title</h6>
                                    <small class="text-muted">@exam.ExamDate.ToString("dd/MM/yyyy hh:mm tt")</small><br />
                                    <small class="text-muted">Duration: @exam.Duration</small>
                                </div>
                                <div>
                                    @if (exam.IsRegistered)
                                    {
                                        <span class="badge bg-success">Registered</span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary">Register</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No upcoming exams.</p>
                    }

                </div>
            </div>

            <div class="card border shadow-sm">
                <div class="card-header bg-white fw-bold">Recent Exam Results</div>
                <div class="card-body" style="max-height: 350px; overflow-y: auto;">
                    @if (Model.ExamHistory.Any())
                    {
                        @foreach (var exam in Model.ExamHistory)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @GetStatusIcon("completed") fs-5"></i>
                                    <div>
                                        <h6 class="mb-0"> @exam.Title</h6>
                                        <small class="text-muted">@exam.Date.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    @if (exam.Status == "completed")
                                    {
                                        <div class="fw-bold @GetScoreColor(exam.Score, exam.MaxScore)">
                                            @exam.Score/@exam.MaxScore
                                        </div>
                                        <small class="text-muted">@((int)((exam.Score / (double)exam.MaxScore) * 100))%</small>
                                    }
                                    else
                                    {
                                        <div class="text-danger">Missed</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No exam history available.</p>
                    }

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white fw-bold">Performance Overview</div>
                <div class="card-body">

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <small>Exam Completion</small>
                            <small class="fw-semibold">@Model.ExamCompletion%</small>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width:@Model.ExamCompletion%"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <small>Average Score</small>
                            <small class="fw-semibold">@Model.AverageScore%</small>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-warning" style="width: @Model.AverageScore%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
