@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "AccessDeniedPage Page";

}
<div class="min-vh-100 d-flex flex-column align-items-center  " style="background-color:  #EAEFEF;">
    <div class="d-flex justify-content-center align-items-center my-5">
        <img src="@Url.Content("~/img/logos/examportal-logo-transparent.png")" alt="" class="img-fluid me-2"
            style="width: 10%" />

    </div>
    <div class="d-flex flex-column justify-content-center align-items-center gap-3">
        <h1 style="font-size: 30vh; color:  var(--primary_color);" class="title">403</h1>
        <span style="color: var(--primary_color) !important ;" class="fs-3">Access Denied!</span>
        <span style="color:  var(--primary_color) !important;" class="title fs-3">Sorry! you are not authorized for this
            page.</span>
        <form method="post" asp-controller="Account" asp-action="Logout">
            <button class="  btn border    primary-button  btn-lg px-5 " type="submit">Back to Login</button>
        </form>

    </div>
</div>